PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=vehicle_transport_management
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

# Fuel buffer applied on top of calculated base fuel, e.g. 0.10 = 10%
FUEL_BUFFER_PERCENT=0.10

# Optional: OSRM routing server for real road-distance routing.
# If not set, the system falls back to a haversine-based estimate
# with a road-distance correction factor.
OSRM_BASE_URL=https://router.project-osrm.org
